{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash .bob/hooks/check-dependencies.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "cmd /c .bob\\hooks\\check-dependencies.bat",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
