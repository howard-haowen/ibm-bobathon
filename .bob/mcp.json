{
  "mcpServers": {
    "netnewswire": {
      "command": "npx",
      "args": [
        "@jellllly/netnewswire-mcp"
      ]
    },
    "rss-reader": {
      "command": "npx",
      "args": [
        "-y",
        "rss-reader-mcp"
      ]
    },
    "zotero": {
      "command": "/Users/haowen_jiang/.local/bin/zotero-mcp",
      "args": [
        "serve"
      ],
      "env": {
        "ZOTERO_LOCAL": "true"
      }
    },
    "workspacemcp": {
      "type": "streamable-http",
      "url": "http://localhost:8000/mcp"
    }
  }
}
