{
  "mcpServers": {
    "netnewswire": {
      "command": "npx",
      "args": ["@jellllly/netnewswire-mcp"]
    },
    "rss-reader": {
      "command": "npx",
      "args": [
        "-y",
        "rss-reader-mcp"
      ]
    },
    "zotero": {
      "command": "zotero-mcp",
      "env": { "ZOTERO_LOCAL": "true" }
    }
  }
}
