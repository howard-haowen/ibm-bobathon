{
  "mcpServers": {
    "netnewswire": {
      "command": "/opt/homebrew/bin/npx",
      "args": [
        "-y",
        "@jellllly/netnewswire-mcp"
      ],
      "env": {
        "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
      },
      "disabled": false
    },
    "rss-reader": {
      "command": "/opt/homebrew/bin/npx",
      "args": [
        "-y",
        "rss-reader-mcp"
      ],
      "env": {
        "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
      }
    },
    "zotero": {
      "command": "/Users/haowen_jiang/.local/bin/zotero-mcp",
      "args": [
        "serve"
      ],
      "env": {
        "ZOTERO_LOCAL": "true"
      },
      "disabled": true
    },
    "workspacemcp": {
      "type": "streamable-http",
      "url": "http://localhost:8000/mcp",
      "disabled": true
    },
    "excalidraw": {
      "url": "https://mcp.excalidraw.com",
      "disabled": true
    }
  }
}